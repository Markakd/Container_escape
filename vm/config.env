VM_USER="${VM_USER:-ubuntu}"
VM_CPUS="${VM_CPUS:-2}"
VM_MEMORY_MB="${VM_MEMORY_MB:-4096}"
VM_MACHINE="${VM_MACHINE:-q35}"
VM_BOOT_TIMEOUT="${VM_BOOT_TIMEOUT:-180}"
VM_EXPECTED_KERNEL="${VM_EXPECTED_KERNEL:-}"
VM_SSH_PORT="${VM_SSH_PORT:-2222}"
VM_PAYLOAD_CONSOLE="${VM_PAYLOAD_CONSOLE:-0}"
VM_BUILD_SSH_PORT="${VM_BUILD_SSH_PORT:-23998}"
VM_BUILD_TIMEOUT="${VM_BUILD_TIMEOUT:-1800}"
VM_SHUTDOWN_TIMEOUT="${VM_SHUTDOWN_TIMEOUT:-120}"

UBUNTU_VERSION="${UBUNTU_VERSION:-26.04}"
# Latest official release images available on September 16, 2026.
case "$UBUNTU_VERSION" in
    24.04)
        default_release_url="https://cloud-images.ubuntu.com/releases/noble/release-20260911"
        ;;
    26.04)
        default_release_url="https://cloud-images.ubuntu.com/releases/resolute/release-20260823"
        ;;
    *)
        default_release_url="https://cloud-images.ubuntu.com/releases/${UBUNTU_VERSION}/release"
        ;;
esac
UBUNTU_RELEASE_URL="${UBUNTU_RELEASE_URL:-$default_release_url}"
UBUNTU_IMAGE_URL="${UBUNTU_IMAGE_URL:-${UBUNTU_RELEASE_URL}/ubuntu-${UBUNTU_VERSION}-server-cloudimg-amd64.img}"
UBUNTU_SUMS_URL="${UBUNTU_SUMS_URL:-${UBUNTU_RELEASE_URL}/SHA256SUMS}"

DOCKER_IMAGE="${DOCKER_IMAGE:-ubuntu:${UBUNTU_VERSION}}"
GOLDEN_IMAGE="${GOLDEN_IMAGE:-$VM_DIR/ubuntu-${UBUNTU_VERSION}.qcow2}"
SSH_KEY="${SSH_KEY:-$VM_DIR/ssh/id_ed25519}"
